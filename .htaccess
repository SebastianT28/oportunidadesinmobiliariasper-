Options +FollowSymLinks -Indexes
DirectoryIndex index.php index.html

# ── Compresión GZIP ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ── Caché de Navegador ───────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/xml                  "access plus 0 seconds"
    ExpiresByType application/json          "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType image/jpg                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/avif                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType font/otf                  "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
    ExpiresByType application/font-woff2    "access plus 1 year"
</IfModule>

# ── Cache-Control Headers ────────────────────────────────────
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|ico|svg|woff|woff2|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
    # Seguridad adicional
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On
RewriteBase /

# ── Redirección SIN WWW ──────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.oportunidadesinmobiliariasperu\.com$ [NC]
RewriteRule ^(.*)$ https://oportunidadesinmobiliariasperu.com/$1 [L,R=301]

# ── Si es un archivo real existente (CSS, JS, imágenes), servir directamente
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Páginas principales ──────────────────────────────────────
RewriteRule ^$                          index.php [L]
RewriteRule ^proyecto/?$                proyecto.php [L]
# ── Alquileres ─────────────────────────────────────────────────
RewriteRule ^alquiler/([a-z0-9-]+)/?$   alquiler/detalle.php?slug=$1 [QSA,L]
RewriteRule ^alquiler/?$                alquiler.php [L]
RewriteRule ^nosotros/?$                nosotros.php [L]

# ── Novedades / Blog ─────────────────────────────────────────
RewriteRule ^novedades/([a-z0-9-]+)/?$  novedades/articulo.php?slug=$1 [QSA,L]
RewriteRule ^novedades/?$               novedades.php [L]

# ── Terrenos ─────────────────────────────────────────────────
RewriteRule ^terrenos/([a-z0-9-]+)/?$   terrenos/detalle.php?slug=$1 [QSA,L]
RewriteRule ^terrenos/?$                terrenos.php [L]

# ── Casas ────────────────────────────────────────────────────
RewriteRule ^casas/([a-z0-9-]+)/?$      casas/detalle.php?slug=$1 [QSA,L]
RewriteRule ^casas/?$                   casas.php [L]

# ── Departamentos ────────────────────────────────────────────
RewriteRule ^departamentos/([a-z0-9-]+)/?$ departamentos/detalle.php?slug=$1 [QSA,L]
RewriteRule ^departamentos/?$           departamentos.php [L]

# ── Airbnb ───────────────────────────────────────────────────
RewriteRule ^airbnb/([a-z0-9-]+)/?$         airbnb/detalle.php?slug=$1 [QSA,L]
RewriteRule ^airbnb/?$                      airbnb.php [L]


# ── Contacto, Legales & Conversión ───────────────────────────
RewriteRule ^contacto/?$                contacto.php [L]
RewriteRule ^politica-de-privacidad/?$  politica-de-privacidad.php [L]
RewriteRule ^terminos-y-condiciones/?$  terminos-y-condiciones.php [L]
RewriteRule ^gracias/?$                 gracias.php [L]

# ── Legado & Utilidades ──────────────────────────────────────
RewriteRule ^articulo/(.+)$             article.php?id=$1 [QSA,L]
RewriteRule ^sitemap/?$                 sitemap.xml [L]
RewriteRule ^404/?$                     error.php [L]
RewriteRule ^error/?$                   error.php [L]

ErrorDocument 404 /error.php